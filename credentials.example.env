# Public MystoraX Conductor base.
MYSTORAX_CONDUCTOR_URL=https://mx.parallex.ca

# Supply through a shell secret store or the front's credential UI.
# Never commit a populated value and never write it into .mcp.json.
MYSTORAX_HOST_TOKEN=

# Optional compatible front-side alias. Prefer MYSTORAX_HOST_TOKEN.
# MYSTORAX_HOST_INGRESS_TOKEN=

# Client request timeout in seconds.
MYSTORAX_HTTP_TIMEOUT_S=120

# Live verify deadline in seconds.
MYSTORAX_VERIFY_TIMEOUT_S=180

# MYSTORAX_AXIOM_MCP_TOKEN is Conductor-side only.
# Do not place it on a front or in this repository.
