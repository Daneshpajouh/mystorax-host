{
  "schema": "mystorax.host.modules.v2",
  "version": "3.0.0",
  "authority": {
    "capabilities": "https://mystorax-api.parallex.ca/capabilities",
    "mcp": "https://mystorax-api.parallex.ca/mcp"
  },
  "modules": [
    {
      "id": "use-mystorax",
      "task": "discover and invoke verified providers and CLIs",
      "tool": "capabilities / invoke / job_status / cancel_job / get_artifact",
      "http": "GET /capabilities; POST /invoke; GET or DELETE /jobs/{id}; GET /artifacts/{id}"
    },
    {
      "id": "use-mystorax-science",
      "task": "use the single consolidated Science catalog",
      "tool": "capabilities then invoke(adapter=science)",
      "http": "GET /capabilities; POST /invoke"
    }
  ]
}
